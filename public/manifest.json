{
  "manifest_version": 3,
  "name": "Dev Pulse",
  "version": "1.0",
  "description": "Developer progress dashboard",
  "permissions": ["storage"],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+B"
      }
    }
  }
}
