# Read the commit message from the passed file
commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Define a portable regex for the desired commit message format
regex="^(feat|fix|docs|style|refactor|perf|test|chore)(\\([a-zA-Z0-9_\\-]+\\))?: .{10,}$"

# Allow merge commits
merge_regex="^Merge branch|^Merge pull request"

# Check if the commit message matches the pattern or is a merge commit
if ! echo "$commit_msg" | grep -Eq "$regex" && ! echo "$commit_msg" | grep -Eq "$merge_regex"; then
  echo "❌ Invalid commit message format."
  echo
  echo "Format: <type>(<scope>): <short description>"
  echo "Example: feat(auth): add login feature"
  echo
  echo "Valid types: feat, fix, docs, style, refactor, perf, test"
  echo "Scope is optional but must be in parentheses if included."
  echo "Short description must be at least 10 characters long."
  exit 1
fi

echo "✅ Commit message format is valid."
